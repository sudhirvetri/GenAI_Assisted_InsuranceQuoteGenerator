        <mxCell id="TFz2z2pdRXmNNbDOTbMO-98" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0277BD;fontStyle=1;fontSize=14;align=center;" value="Flow B - Real-Time Conversational AI Pipeline" vertex="1">
          <mxGeometry height="40" width="660" x="1550" y="700" as="geometry" />
        </mxCell>
        <mxCell id="TFz2z2pdRXmNNbDOTbMO-99" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#0277BD;fillColor=#E1F5FE;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=12;spacingRight=10;" value="&lt;b&gt;12.&lt;/b&gt; User asks a follow-up question (e.g., &amp;quot;Why did Plan A score higher than Plan B?&amp;quot;) over the &lt;b&gt;already-open WebSocket&lt;/b&gt; - bypassing ALB / ECS / SQS entirely.&lt;br&gt;&lt;br&gt;&lt;b&gt;13.&lt;/b&gt; API Gateway routes the chat message directly to a dedicated lightweight Chat Conversation Lambda.&lt;br&gt;&lt;br&gt;&lt;b&gt;14.&lt;/b&gt; Chat Lambda reads the rolling conversation history from DynamoDB and appends the new turn.&lt;br&gt;&lt;br&gt;&lt;b&gt;15.&lt;/b&gt; Chat Lambda invokes Amazon Bedrock with the conversational context; the response streams back through the same WebSocket connection to the user. Ultra-low latency, no heavy DB hits." vertex="1">
          <mxGeometry height="410" width="660" x="1550" y="740" as="geometry" />
        </mxCell>
