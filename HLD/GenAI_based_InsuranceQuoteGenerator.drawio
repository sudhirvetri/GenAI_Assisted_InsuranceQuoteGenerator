        <mxCell id="TFz2z2pdRXmNNbDOTbMO-55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="upstream&amp;nbsp;&lt;div&gt;underwriting system&lt;/div&gt;&lt;div&gt;publishing plan details&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="951.15" y="931" as="geometry" />
        </mxCell>
        <mxCell id="TFz2z2pdRXmNNbDOTbMO-61" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" value="AWS Cloud Trial" vertex="1">
          <mxGeometry height="62" width="62" x="832.5" y="1495" as="geometry" />
        </mxCell>
        <mxCell id="TFz2z2pdRXmNNbDOTbMO-69" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#223548;strokeColor=none;gradientDirection=east;fillColor=#5b738b;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="1" vertex="1">
          <mxGeometry height="30" width="30" x="414" y="150" as="geometry" />
        </mxCell>
        <mxCell id="TFz2z2pdRXmNNbDOTbMO-72" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#F57F17;fillColor=#FFFDE7;align=left;verticalAlign=top;fontSize=12;spacingLeft=14;spacingTop=12;spacingRight=10;" value="&lt;b&gt;1.&lt;/b&gt; User signs in via Google Identity Provider. Amazon Cognito completes the OIDC handshake and issues a JWT to the browser.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Browser opens a persistent WebSocket through API Gateway. A Cognito Lambda authorizer validates the $connect handshake; the assigned &lt;i&gt;connection_id&lt;/i&gt; is stored in DynamoDB against &lt;i&gt;user_id&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; User submits the insurance form. HTTPS traffic hits CloudFront (WAF inspects), then is forwarded to the Application Load Balancer.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; ALB validates the Cognito session cookie via its native authenticate-cognito listener rule and forwards the request to ECS Fargate (Ingestion API).&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; ECS writes the transaction to RDS Transaction DB and generates a &lt;i&gt;transaction_id&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; ECS pushes a lightweight message (transaction_id, user_id, connection_id) to SQS and immediately returns &lt;b&gt;HTTP 202 Accepted&lt;/b&gt; to the browser - the HTTP request closes within milliseconds.&lt;br&gt;&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; SQS triggers the Quote Worker Lambda asynchronously (batch size 1, with a Maximum Concurrency cap to protect downstream RDS).&lt;br&gt;&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Quote Lambda fetches matching plan templates from RDS Plan Master DB (read replica).&lt;br&gt;&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; Quote Lambda builds the GenAI prompt and invokes Amazon Bedrock.&lt;br&gt;&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; As Bedrock generates tokens, Lambda streams them through the API Gateway WebSocket (using the stored connection_id) back to the user - text appears live on the screen.&lt;br&gt;&lt;br&gt;&lt;b&gt;11.&lt;/b&gt; If SQS message processing fails 3 times, the message is moved to the DLQ for inspection / replay." vertex="1">
          <mxGeometry height="540" width="660" x="1550" y="130" as="geometry" />
        </mxCell>
        <mxCell id="TFz2z2pdRXmNNbDOTbMO-73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEB3B;strokeColor=#F57F17;fontStyle=1;fontSize=14;align=center;" value="Flow A - Asynchronous Quote Generation Pipeline" vertex="1">
          <mxGeometry height="40" width="660" x="1550" y="90" as="geometry" />
        </mxCell>
        <mxCell id="TFz2z2pdRXmNNbDOTbMO-74" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;" value="Flow Reference Guide" vertex="1">
          <mxGeometry height="40" width="650" x="1550" y="40" as="geometry" />
        </mxCell>
        <mxCell id="TFz2z2pdRXmNNbDOTbMO-75" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#223548;strokeColor=none;gradientDirection=east;fillColor=#5b738b;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="2" vertex="1">
